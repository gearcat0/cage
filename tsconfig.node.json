{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shell/**/*.ts",
    "src/format/**/*.ts",
    "src/conformance/**/*.ts",
    "test/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "electron.vite.config.ts"
  ],
  "exclude": ["src/shell/chrome/chrome.ts", "src/shell/chrome/css.d.ts"]
}
