{
  "name": "souspli",
  "version": "0.1.1",
  "private": true,
  "description": "Signed, self-contained letters exchanged between people instead of pages rendered by a server. A desktop client with a sealed container for untrusted content.",
  "license": "Apache-2.0",
  "main": "./out/main/shell/main.js",
  "author": "gearcat0 <large.oil2707@fastmail.com>",
  "homepage": "https://souspli.org",
  "repository": "github:souspli/souspli",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:nosandbox": "cross-env ELECTRON_DISABLE_SANDBOX=1 electron-vite dev",
    "dev:cage": "electron-vite build && electron out/main/index.js",
    "build": "electron-vite build",
    "start": "electron out/main/shell/main.js",
    "preview": "electron-vite preview",
    "gen:icon": "electron scripts/make-icon.mjs",
    "pack:dir": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder",
    "dist:linux": "pnpm build && electron-builder --linux",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:win:signed": "node scripts/dist-win-signed.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "rebuild:native": "electron-rebuild -f -o better-sqlite3",
    "postinstall": "electron-rebuild -f -o better-sqlite3 || true",
    "gen:vectors": "tsx src/conformance/generate.ts",
    "gen:welcome": "tsx tools/welcome/make.ts",
    "welcome:forum": "tsx tools/welcome/forum.ts",
    "world": "node scripts/run-world.mjs",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:cage": "pnpm build && node scripts/run-cage-tests.mjs",
    "test:cage:headed": "pnpm build && node scripts/run-cage-tests.mjs --headed"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@scure/bip32": "^2.2.0",
    "@scure/bip39": "^2.2.0",
    "better-sqlite3": "^12.2.0",
    "electron-updater": "6.8.9",
    "webtorrent": "^3.0.21",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^10.1.0",
    "electron": "^43.7.6",
    "electron-builder": "^26.16.1",
    "electron-vite": "^5.0.0",
    "playwright": "^1.61.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.11"
  }
}
